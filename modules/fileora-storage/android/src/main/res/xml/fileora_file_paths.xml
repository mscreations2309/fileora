<?xml version="1.0" encoding="utf-8"?>
<!--
  Roots Fileora may hand to other apps when the user explicitly opens or shares a file.
  root-path is required for removable volumes (/storage/XXXX-XXXX), which have no dedicated tag.
  Grants are per-file, temporary, and read-only.
-->
<paths>
  <root-path name="root" path="." />
  <external-path name="external" path="." />
  <files-path name="files" path="." />
  <cache-path name="cache" path="." />
</paths>
